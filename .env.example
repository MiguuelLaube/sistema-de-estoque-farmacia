# ====================================================================
# TEMPLATE GERAL DE VARIÁVEIS DE AMBIENTE (COPIE PARA .env.local)
# ====================================================================

# 1. Cliente Público (Frontend Browser - seguro com RLS ativo no Supabase)
#    ATENÇÃO: tudo com prefixo VITE_ vai para o navegador. NUNCA coloque service_role/sb_secret aqui.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_publica_anon_ou_publishable
VITE_DATA_MODE=supabase
VITE_APP_ENV=development

# 2. Segredos Exclusivos de Servidor (/api/* - NUNCA usar prefixo VITE_)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_publica_anon_ou_publishable
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=drogaria
EVOLUTION_API_KEY=gere_uma_chave_aleatoria_de_256_bits_aqui

# 3. Somente servidor (Vercel > Settings > Environment Variables). Nunca commitar, nunca VITE_.
#    Necessária para: ler credenciais de WhatsApp próprio e gerar o link de senha com token no e-mail personalizado.
SUPABASE_SERVICE_ROLE_KEY=

# 4. URL pública do site (usada nos links dos e-mails). Ex.: https://encomed.vercel.app
APP_URL=http://localhost:5173

# 5. E-mail transacional (opcional - o Brevo é preferido; sem chaves usa o e-mail nativo do Supabase)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=EncoMed
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
